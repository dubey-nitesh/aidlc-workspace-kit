# AWS AI-DLC 1.x: rules in CLAUDE.md / AGENTS.md / .kiro / .amazonq …, output in aidlc-docs/.
# Profile format: docs/DESIGN.md §4. Paths are relative to the working repo root;
# a trailing '/' marks a directory.
version=1
name=aidlc-v1
description=AWS AI-DLC 1.x (output in aidlc-docs/)
detect=aidlc-docs/
detect=.aidlc-rule-details/
detect=.kiro/aws-aidlc-rule-details/
detect=.amazonq/aws-aidlc-rule-details/
path=aidlc-docs/
